{
    "name": "gecka/spamfilter",
    "description": "Statistical spam filter for short user-submitted texts (contact forms, comments), pure PHP",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "spam",
        "filter",
        "bayesian",
        "naive-bayes",
        "contact-form",
        "comments"
    ],
    "authors": [
        {
            "name": "Laurent Dinclaux",
            "email": "laurent@gecka.nc"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gecka\\SpamFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gecka\\SpamFilter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "ext-apcu": "Keeps the model in shared memory between requests"
    },
    "bin": [
        "bin/spamfilter-background"
    ]
}
